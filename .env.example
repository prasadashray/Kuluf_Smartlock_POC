# IndiaLock Connect POC configuration. Copy to .env and fill in. Never commit .env.

# ---------- PostgreSQL (docker compose service "db") ----------
POSTGRES_DB=indialock
POSTGRES_USER=indialock
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://indialock:change-me@127.0.0.1:5433/indialock
# DB_ENABLED=false runs capture-only mode with an in-memory store (traffic still goes to CAPTURE_FILE)
DB_ENABLED=true

# ---------- Device TCP listener (must be reachable from the Airtel mobile network) ----------
TCP_HOST=0.0.0.0
TCP_PORT=6808
MAX_FRAME_LENGTH=4096

# ---------- REST API (keep on localhost; the protocol has no encryption) ----------
API_HOST=127.0.0.1
API_PORT=3000
# Optional bearer token for the API (empty = no auth, POC only)
API_TOKEN=
API_CORS_ORIGIN=http://localhost:5173

# ---------- Device behaviour ----------
# Offset of all device BCD times from UTC in minutes. Protocol: GMT+8 (480). BLE evidence H-07 agrees.
DEVICE_TZ_OFFSET_MINUTES=480
# No frame for this long => device offline, socket closed (JT/T808 §5.3)
DEVICE_OFFLINE_TIMEOUT_S=300

# ---------- Authentication ----------
# accept_all: accept any 0x0102 and record the code | known_devices: only stored/allowed codes
AUTH_MODE=accept_all
# Comma-separated codes accepted in known_devices mode
ALLOWED_AUTH_CODES=
# Reply to 0x0100: issue_code | reject
REGISTRATION_MODE=issue_code
REQUIRE_AUTH_FOR_COMMANDS=true

# Protocol §8.9 note: send 0x8103 param 0x002A (time) ~500 ms after authentication
TIME_SYNC_ON_AUTH=true
TIME_SYNC_DELAY_MS=500

# ---------- TT e-lock business frame (UNVERIFIED on hardware - see docs/PROTOCOL_NOTES.md) ----------
# LEN byte meaning: after_len | after_len_excl_crc | doc_example
BIZ_LEN_MODE=after_len
# CRC algorithm: crc8_maxim | xor | sum | none ; range: from_len | from_head
BIZ_CRC_ALGO=crc8_maxim
BIZ_CRC_RANGE=from_len
# Reject uplink business frames whose CRC does not match (enable only once validated on hardware)
BIZ_CRC_ENFORCE=false
# Send the 0x61 "normal reply" to lock info uploads (protocol is ambiguous - DOC-11)
BIZ_REPLY_TO_LOCK_UPLOAD=false

# ---------- Lock commands ----------
COMMAND_TIMEOUT_S=60
# rf10 (10-digit RF lock key) | ascii6 (6-digit password lock) | hex (12 hex chars)
DEFAULT_KEY_FORMAT=rf10
DEFAULT_GATE=0
DEFAULT_BILL=0
DEFAULT_LINE_CODE=0

# ---------- Logging ----------
LOG_LEVEL=info
PROTOCOL_VERBOSE=true
MESSAGE_LOG_DB=true
LOG_RAW_TCP_CHUNKS=true
# JSONL capture of every raw TCP chunk and frame (relative to repo root if not absolute)
CAPTURE_FILE=captures/traffic.jsonl
ACK_UNKNOWN_MESSAGES=true
